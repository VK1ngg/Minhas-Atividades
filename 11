listaA = [1, 3, 5, 7, 8]
listaB = [2, 4, 6, 9, 10, 11, 12]
listaC = [0] * 12
x = y = 0

for i in range (12):
    if x == 5:
        listaC[i] = listaB[y]
        y += 1
    elif y == 7:
        listaC[i] = listaA[x]
        x += 1
    else:
        if listaA[x] > listaB[y]:
            listaC[i] = listaB[y]
            y += 1

        else:
            listaC[i] = listaA[x]
            x += 1

print (f"A nova lista é", listaC)
