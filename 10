lista = [0] * 10
n1 = 1
n2 = 0

for i in range (10):
    lista[i] = int(input(f"Digite o {i+1}º número da lista: "))

for i in range (9):
    if lista[i] < lista[i+1]:
        n1 += 1
    else:
        if n1 > n2:
            n2 = n1
            n1 = 1

print (f"A maior sequência de números crescentes nessa lista é {n2}.")
